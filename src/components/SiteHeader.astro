---
/**
 * SiteHeader — the single fixed top bar used across the public site.
 *
 * Replaces the seven hand-maintained copies that had drifted apart in link
 * set, spacing and colour. Two themes cover every page: `light` (homepage /
 * editorial) and `dark` (landing pages, which render on a near-black hero).
 *
 * Styling is deliberately self-contained: landing pages each declare their own
 * `:root` palettes (`--mx`, `--muted`, `--brd`) while the homepage uses
 * `--color-*`, so a shared component cannot rely on either. All values below
 * resolve from the component's own custom properties.
 *
 * Mobile behaviour (hamburger, slide-down panel, dropdown tap targets) is
 * driven by the global `.top-bar` rules and click handler in BaseLayout, which
 * match on these class names.
 */
interface CTA {
  href: string;
  label: string;
  /** `line` = LINE-green pill. `solid` = white pill for dark backgrounds. */
  style?: "line" | "solid";
  /** Defaults to LINE for existing contact CTAs. */
  icon?: "line" | "cart";
}

interface Props {
  theme?: "light" | "dark";
  /** Pathname of the current page, e.g. "/cgm" — marks the active link. */
  current?: string;
  cta?: CTA | null;
  /** Social icon row — homepage only today. */
  social?: boolean;
}

const { theme = "dark", current = "", cta = null, social = false } = Astro.props;

const navLinks = [
  { href: "/", label: "หน้าแรก" },
  { href: "/blog", label: "บทความ" },
  { href: "/diabetes-guide", label: "หนังสือเบาหวานผอม" },
];

const services = [
  { href: "/cgm", icon: "📟", title: "คอร์ส CGM", desc: "รักษาเบาหวานด้วย CGM · 14 วัน" },
  { href: "/vip-coaching", icon: "💎", title: "VIP 1:1 Coaching", desc: "ดูแลตัวต่อตัว 12 สัปดาห์", vip: true },
  { href: "/consult", icon: "🩺", title: "ปรึกษาส่วนตัว", desc: "พบหมอทิม 1:1 · เริ่ม 800 บาท" },
];

const norm = (p: string) => (p !== "/" ? p.replace(/\/$/, "") : p);
const isActive = (href: string) => norm(href) === norm(current);
const serviceActive = services.some((s) => isActive(s.href));

const socialLinks = [
  { href: "https://www.facebook.com/dr.timdietclinic/", label: "Facebook", path: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" },
  { href: "https://www.youtube.com/@dr.timdietclinic", label: "YouTube", path: "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" },
  { href: "https://www.instagram.com/dr.timdietclinic/", label: "Instagram", path: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" },
  { href: "https://lin.ee/LwEtisp", label: "LINE", path: "M24 10.5C24 4.701 18.627 0 12 0S0 4.701 0 10.5c0 5.19 4.604 9.537 10.824 10.362.42.092.992.28 1.137.641.13.328.085.84.042 1.17l-.184 1.107c-.056.328-.26 1.284 1.124.7 1.384-.584 7.466-4.396 10.184-7.525C25.18 14.703 24 12.727 24 10.5z" },
];

const LINE_GLYPH = "M24 10.5C24 4.701 18.627 0 12 0S0 4.701 0 10.5c0 5.19 4.604 9.537 10.824 10.362.42.092.992.28 1.137.641.13.328.085.84.042 1.17l-.184 1.107c-.056.328-.26 1.284 1.124.7 1.384-.584 7.466-4.396 10.184-7.525C25.18 14.703 24 12.727 24 10.5z";
const CART_GLYPH = "M19 6h-2a5 5 0 00-10 0H5a2 2 0 00-2 2v12a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2zm-7-3a3 3 0 013 3H9a3 3 0 013-3zm7 17H5V8h2v2h2V8h6v2h2V8h2v12z";
---

<header class="top-bar" data-theme={theme}>
  <div class="top-bar-inner">
    <a href="/" class="top-bar-brand">
      <span class="brand-icon">⚕</span>
      <span class="brand-name">Dr. Tim</span>
    </a>

    <button class="mobile-menu-toggle" type="button" aria-label="Toggle Menu">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <nav class="top-bar-nav" aria-label="เมนูหลัก">
      {navLinks.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>{l.label}</a>
      ))}

      <div class="nav-dropdown">
        <button
          class="nav-dropdown-trigger"
          type="button"
          aria-expanded="false"
          aria-current={serviceActive ? "true" : undefined}
        >
          บริการ
          <svg class="nav-dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="nav-dropdown-menu">
          {services.map((s) => (
            <a
              href={s.href}
              class:list={["dropdown-item", { "dropdown-item-vip": s.vip }]}
              aria-current={isActive(s.href) ? "page" : undefined}
            >
              <span class="dropdown-icon" aria-hidden="true">{s.icon}</span>
              <div>
                <strong>{s.title}</strong>
                <span>{s.desc}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </nav>

    {social && (
      <div class="top-bar-social">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.path}></path></svg>
          </a>
        ))}
      </div>
    )}

    {cta && (
      <a
        href={cta.href}
        target="_blank"
        rel="noopener"
        class:list={["nav-cta-btn", `nav-cta-${cta.style ?? "line"}`]}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={cta.icon === "cart" ? CART_GLYPH : LINE_GLYPH}></path></svg>
        {cta.label}
      </a>
    )}
  </div>
</header>

<style>
  .top-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--hdr-z);
    background: var(--hdr-bg);
    backdrop-filter: blur(var(--hdr-blur));
    -webkit-backdrop-filter: blur(var(--hdr-blur));
    border-bottom: 1px solid var(--hdr-border);
  }

  .top-bar[data-theme="light"] {
    --hdr-z: 50;
    --hdr-bg: rgba(255, 255, 255, 0.85);
    --hdr-blur: 12px;
    --hdr-border: rgba(0, 0, 0, 0.06);
    --hdr-max: 1152px;
    --hdr-pad: 10px 16px;
    --hdr-gap: 16px;
    --hdr-brand: #1a1a2e;
    --hdr-link: #6b7280;
    --hdr-link-hover: #0f766e;
    --hdr-menu-bg: #ffffff;
    --hdr-menu-border: rgba(0, 0, 0, 0.08);
    --hdr-menu-title: #1a1a2e;
    --hdr-menu-desc: #6b7280;
    --hdr-menu-hover: rgba(15, 118, 110, 0.06);
    --hdr-social-hover-bg: #f0fdfa;
  }

  .top-bar[data-theme="dark"] {
    --hdr-z: 100;
    --hdr-bg: rgba(10, 15, 13, 0.85);
    --hdr-blur: 16px;
    --hdr-border: rgba(255, 255, 255, 0.08);
    --hdr-max: 1100px;
    --hdr-pad: 12px 24px;
    --hdr-gap: 24px;
    --hdr-brand: #ffffff;
    --hdr-link: rgba(255, 255, 255, 0.6);
    --hdr-link-hover: #14b8a6;
    --hdr-menu-bg: #111816;
    --hdr-menu-border: rgba(255, 255, 255, 0.1);
    --hdr-menu-title: #f0fdf4;
    --hdr-menu-desc: rgba(255, 255, 255, 0.55);
    --hdr-menu-hover: rgba(255, 255, 255, 0.06);
    --hdr-social-hover-bg: rgba(255, 255, 255, 0.08);
  }

  .top-bar-inner {
    max-width: var(--hdr-max);
    margin: 0 auto;
    padding: var(--hdr-pad);
    display: flex;
    align-items: center;
    gap: var(--hdr-gap);
  }

  .top-bar-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--hdr-brand);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    white-space: nowrap;
    text-decoration: none;
  }

  .brand-icon {
    font-size: 20px;
  }

  .top-bar-nav {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-right: auto;
  }

  .top-bar-nav a {
    font-size: 13px;
    font-weight: 500;
    color: var(--hdr-link);
    text-decoration: none;
    transition: color 200ms;
    white-space: nowrap;
  }

  .top-bar-nav a:hover,
  .top-bar-nav a[aria-current="page"] {
    color: var(--hdr-link-hover);
  }

  /* ── Services dropdown ── */
  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    color: var(--hdr-link);
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px 0;
    transition: color 200ms;
  }

  .nav-dropdown-trigger:hover,
  .nav-dropdown-trigger[aria-current="true"] {
    color: var(--hdr-link-hover);
  }

  .nav-dropdown-arrow {
    transition: transform 200ms;
  }

  .nav-dropdown:hover .nav-dropdown-arrow,
  .nav-dropdown:focus-within .nav-dropdown-arrow {
    transform: rotate(180deg);
  }

  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    min-width: 240px;
    background: var(--hdr-menu-bg);
    border: 1px solid var(--hdr-menu-border);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    padding: 6px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms, transform 200ms;
  }

  .nav-dropdown:hover .nav-dropdown-menu,
  .nav-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    transition: background 150ms;
    text-decoration: none;
    color: inherit;
  }

  .dropdown-item:hover {
    background: var(--hdr-menu-hover);
  }

  .dropdown-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .dropdown-item strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--hdr-menu-title);
  }

  .dropdown-item span {
    font-size: 11px;
    color: var(--hdr-menu-desc);
  }

  .dropdown-item-vip strong {
    color: #b45309;
  }

  .top-bar[data-theme="dark"] .dropdown-item-vip strong {
    color: #fbbf24;
  }

  /* ── Social icons ── */
  .top-bar-social {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--hdr-link);
    transition: all 200ms;
  }

  .social-icon:hover {
    background: var(--hdr-social-hover-bg);
  }

  .social-icon:nth-child(1):hover { color: #1877f2; }
  .social-icon:nth-child(2):hover { color: #ff0000; }
  .social-icon:nth-child(3):hover { color: #e4405f; }
  .social-icon:nth-child(4):hover { color: #06c755; }

  /* ── CTA ── */
  .nav-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 200ms;
  }

  .nav-cta-line {
    background: #06c755;
    color: #ffffff;
  }

  .nav-cta-line:hover {
    background: #05b34c;
    transform: translateY(-1px);
  }

  .nav-cta-solid {
    background: #ffffff;
    color: #0a0f0d;
  }

  .nav-cta-solid:hover {
    transform: translateY(-1px);
  }
</style>
