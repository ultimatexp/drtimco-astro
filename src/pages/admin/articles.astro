---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { neon } from '@neondatabase/serverless';

const DATABASE_URL = import.meta.env.NEON_DATABASE_URL;

const url = Astro.url;
const statusFilter = url.searchParams.get('status') || '';
const searchQuery = url.searchParams.get('search') || '';
const inTrash = url.searchParams.get('view') === 'trash';

let articles: any[] = [];
let trashCount = 0;

if (DATABASE_URL) {
    try {
        const sql = neon(DATABASE_URL);

        const pageNum = Math.max(1, parseInt(url.searchParams.get('page') || '1', 10));
        const limit = 20;
        const offset = (pageNum - 1) * limit;

        // One parameterised query instead of a branch per filter combination.
        // `deleted_at` decides which view a row belongs to: the normal list must
        // never show trashed articles, and the trash view shows only those.
        const where = [inTrash ? 'deleted_at IS NOT NULL' : 'deleted_at IS NULL'];
        const params: any[] = [];

        if (statusFilter) {
            params.push(statusFilter);
            where.push(`status = $${params.length}`);
        }
        if (searchQuery) {
            params.push(`%${searchQuery}%`);
            where.push(`title ILIKE $${params.length}`);
        }

        params.push(limit, offset);
        articles = await sql.query(
            `SELECT id, title, slug, category, status, created_at, reviewed_at, deleted_at, featured_image_url
             FROM article_drafts
             WHERE ${where.join(' AND ')}
             ORDER BY created_at DESC
             LIMIT $${params.length - 1} OFFSET $${params.length}`,
            params
        );

        const [{ count }] = await sql`
            SELECT COUNT(*)::int AS count FROM article_drafts WHERE deleted_at IS NOT NULL
        `;
        trashCount = count;
    } catch (e) {
        console.error("Error fetching articles:", e);
    }
}
---

<AdminLayout title="Articles">
    <div class="page-header">
        <div class="header-content">
            <h1>Article Management</h1>
            <p class="text-muted">Manage your drafts, pending reviews, and published articles.</p>
        </div>
        <div class="header-actions">
            <a href="/admin/editor" class="btn-primary">✨ New Article</a>
        </div>
    </div>

    <!-- Active / Trash views -->
    <div class="view-tabs">
        <a href="/admin/articles" class={`view-tab ${!inTrash ? 'active' : ''}`}>Articles</a>
        <a href="/admin/articles?view=trash" class={`view-tab ${inTrash ? 'active' : ''}`}>
            🗑️ Trash
            {trashCount > 0 && <span class="view-tab-count">{trashCount}</span>}
        </a>
    </div>

    <!-- Filters & Search -->
    <div class="filters-card card">
        <form method="GET" class="filters-form" id="filterForm">
            {inTrash && <input type="hidden" name="view" value="trash" />}
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input 
                    type="text" 
                    name="search" 
                    placeholder="Search titles..." 
                    value={searchQuery}
                    class="form-input search-input"
                />
            </div>
            <select name="status" class="form-select status-select" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Statuses</option>
                <option value="draft" selected={statusFilter === 'draft'}>Drafts</option>
                <option value="review" selected={statusFilter === 'review'}>Pending Review</option>
                <option value="approved" selected={statusFilter === 'approved'}>Approved</option>
                <option value="published" selected={statusFilter === 'published'}>Published</option>
            </select>
            {(searchQuery || statusFilter) && (
                <a href="/admin/articles" class="btn-text clear-filters">Clear</a>
            )}
        </form>
    </div>

    <!-- Table -->
    <div class="card table-container">
        {articles.length > 0 ? (
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="thumb-col">Image</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="actions-col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {articles.map(article => (
                        <tr class="article-row" data-id={article.id}>
                            <td class="thumb-cell">
                                {article.featured_image_url ? (
                                    <img src={article.featured_image_url} alt="" class="row-thumb" loading="lazy" />
                                ) : (
                                    <div class="row-thumb-placeholder">📄</div>
                                )}
                            </td>
                            <td>
                                <div class="cell-title">
                                    <a href={`/admin/editor?id=${article.id}`} class="title-link">{article.title}</a>
                                    {article.slug && <span class="slug-text">/{article.slug}</span>}
                                </div>
                            </td>
                            <td>
                                <span class="category-tag">{article.category || 'Uncategorized'}</span>
                            </td>
                            <td>
                                <span class={`status-badge status-${article.status}`}>{article.status}</span>
                            </td>
                            <td>
                                <div class="date-text">
                                    {new Date(article.reviewed_at || article.created_at).toLocaleDateString('en-GB')}
                                </div>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    {inTrash ? (
                                        <button
                                            class="btn-icon restore-btn"
                                            data-id={article.id}
                                            data-title={article.title}
                                            title="Restore from trash"
                                        >↩️</button>
                                    ) : (
                                        <>
                                            <a href={`/admin/editor?id=${article.id}`} class="btn-icon" title="Edit">✏️</a>

                                            {article.status === 'review' && (
                                                <button class="btn-icon approve-btn" data-id={article.id} title="Approve & Publish">✅</button>
                                            )}

                                            <button
                                                class="btn-icon trash-btn"
                                                data-id={article.id}
                                                data-title={article.title}
                                                data-status={article.status}
                                                title="Move to trash"
                                            >🗑️</button>
                                        </>
                                    )}
                                </div>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        ) : (
            inTrash ? (
                <div class="empty-state">
                    <div class="empty-icon">🗑️</div>
                    <h3>Trash is empty</h3>
                    <p>Articles you move to trash appear here, and can be restored.</p>
                    <a href="/admin/articles" class="btn-primary" style="margin-top: 16px;">Back to Articles</a>
                </div>
            ) : (
                <div class="empty-state">
                    <div class="empty-icon">📝</div>
                    <h3>No articles found</h3>
                    <p>Try adjusting your search or filters, or create a new article.</p>
                    <a href="/admin/editor" class="btn-primary" style="margin-top: 16px;">Create First Article</a>
                </div>
            )
        )}
    </div>

</AdminLayout>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 16px;
    }

    .page-header h1 {
        font-size: 1.5rem;
        margin-bottom: 4px;
    }

    .text-muted {
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .view-tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 16px;
        border-bottom: 1px solid var(--border);
    }

    .view-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
    }

    .view-tab:hover {
        color: var(--text-main);
    }

    .view-tab.active {
        color: var(--accent, #3b82f6);
        border-bottom-color: var(--accent, #3b82f6);
    }

    .view-tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--border);
        color: var(--text-main);
        font-size: 0.75rem;
        font-weight: 700;
    }

    .filters-card {
        margin-bottom: 24px;
        padding: 16px 24px;
    }

    .filters-form {
        display: flex;
        gap: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        flex-grow: 1;
        min-width: 250px;
        max-width: 400px;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 0.9rem;
        pointer-events: none;
    }

    .search-input {
        padding-left: 36px;
        width: 100%;
        background-color: var(--bg-base);
    }

    .status-select {
        width: 200px;
        background-color: var(--bg-base);
    }

    /* .form-input, .form-select, .data-table and .btn-icon come from
       AdminLayout's global stylesheet so every admin table looks the same. */
    .clear-filters {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.875rem;
    }
    
    .clear-filters:hover {
        color: var(--text-main);
        text-decoration: underline;
    }

    .table-container {
        padding: 0;
        overflow-x: auto;
    }

    .article-row:hover {
        background-color: var(--bg-surface-hover);
    }

    .cell-title {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .title-link {
        color: var(--text-main);
        font-weight: 500;
        text-decoration: none;
        font-size: 0.95rem;
    }

    .title-link:hover {
        color: var(--primary-text);
    }

    .slug-text {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .category-tag {
        background-color: rgba(148, 163, 184, 0.1);
        color: var(--text-muted);
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-badge {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-block;
    }

    .status-published { background: rgba(34, 197, 94, 0.1); color: var(--success); }
    .status-approved  { background: rgba(59, 130, 246, 0.1); color: var(--primary); }
    .status-review    { background: rgba(245, 158, 11, 0.1); color: var(--warning); }
    .status-draft     { background: rgba(148, 163, 184, 0.1); color: var(--text-muted); }
    .status-rejected  { background: rgba(239, 68, 68, 0.1); color: var(--danger); }

    .date-text {
        font-size: 0.875rem;
        color: var(--text-muted);
    }

    .thumb-col {
        width: 60px;
    }

    .thumb-cell {
        padding: 8px 12px 8px 24px !important;
    }

    .row-thumb {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        object-fit: cover;
        display: block;
        border: 1px solid var(--border);
    }

    .row-thumb-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        background: rgba(148, 163, 184, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        opacity: 0.4;
    }

    .actions-col {
        width: 120px;
    }

    .action-buttons {
        display: flex;
        gap: 8px;
    }

    .empty-state {
        text-align: center;
        padding: 48px 24px;
    }

    .empty-icon {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-size: 1.25rem;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: var(--text-muted);
    }
</style>

<script>
    // Approve article logic
    document.querySelectorAll('.approve-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const currentTarget = e.currentTarget;
            if (!(currentTarget instanceof HTMLButtonElement)) return;
            
            const id = currentTarget.getAttribute('data-id');
            const row = currentTarget.closest('tr');
            
            if (!confirm('Are you sure you want to approve & publish this article? This may trigger a Facebook post.')) {
                return;
            }

            currentTarget.textContent = '⏳';
            currentTarget.disabled = true;

            try {
                const res = await fetch('/api/approve-article', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, action: 'approve' })
                });

                const data = await res.json();
                
                if (data.success) {
                    alert('Successfully approved and published!');
                    window.location.reload();
                } else {
                    alert('Error: ' + data.error);
                    currentTarget.textContent = '✅';
                    currentTarget.disabled = false;
                }
            } catch (err) {
                alert('Network error during approval.');
                currentTarget.textContent = '✅';
                currentTarget.disabled = false;
            }
        });
    });

    // ── Trash / restore ──────────────────────────────────────
    async function articleAction(btn, { url, options, confirmMessage, busyIcon, idleIcon }) {
        if (!confirm(confirmMessage)) return;

        btn.textContent = busyIcon;
        btn.disabled = true;
        try {
            const res = await fetch(url, options);
            const data = await res.json().catch(() => ({}));
            if (data.success) {
                window.location.reload();
            } else {
                alert('Error: ' + (data.error || res.status));
                btn.textContent = idleIcon;
                btn.disabled = false;
            }
        } catch (err) {
            alert('Network error: ' + err.message);
            btn.textContent = idleIcon;
            btn.disabled = false;
        }
    }

    document.querySelectorAll('.trash-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const t = e.currentTarget;
            if (!(t instanceof HTMLButtonElement)) return;
            const id = t.getAttribute('data-id');
            const title = t.getAttribute('data-title') || 'this article';
            const status = t.getAttribute('data-status');
            // A published article is live, so trashing it removes it from the
            // site on the next deploy — say so rather than just "are you sure".
            const liveWarning = (status === 'published' || status === 'approved')
                ? '\n\nThis article is live. It will be removed from the public site on the next deploy.'
                : '';
            articleAction(t, {
                url: `/api/admin/article/${id}`,
                options: { method: 'DELETE' },
                confirmMessage: `Move "${title}" to trash?${liveWarning}\n\nYou can restore it from the Trash tab.`,
                busyIcon: '⏳',
                idleIcon: '🗑️',
            });
        });
    });

    document.querySelectorAll('.restore-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const t = e.currentTarget;
            if (!(t instanceof HTMLButtonElement)) return;
            const id = t.getAttribute('data-id');
            const title = t.getAttribute('data-title') || 'this article';
            articleAction(t, {
                url: `/api/admin/article/${id}`,
                options: {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'restore' }),
                },
                confirmMessage: `Restore "${title}" from trash?`,
                busyIcon: '⏳',
                idleIcon: '↩️',
            });
        });
    });
</script>
